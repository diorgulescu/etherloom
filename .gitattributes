* text=auto eol=lf

# Shell scripts must always use POSIX LF line endings
*.sh text eol=lf

# Rust, TypeScript, Config & Lab bundles
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.icns binary
*.ico binary
